# === JWT Secrets ===
JWT_SECRET=your-jwt-secret-change-this
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_SERVICE_SECRET=your-service-secret-change-this

# === Token Expiry ===
ACCESS_TOKEN_EXPIRY=10m
REFRESH_TOKEN_EXPIRY=1d
SERVICE_TOKEN_EXPIRY=5m

# === Gateway Secret ===
GATEWAY_SECRET=your-gateway-secret-change-this

# === Service Client Credentials ===
SERVICE_CLIENT_ID=grade-service
SERVICE_CLIENT_SECRET=your-service-client-secret-change-this

# === Ports ===
GATEWAY_PORT=3000
GRADE_SERVICE_PORT=3001
TRANSCRIPT_SERVICE_PORT=3002

# === Database ===
DB_PATH=./database/zero-trust.db

# === Access Hours ===
ACCESS_START_HOUR=7
ACCESS_END_HOUR=21
APP_TIMEZONE=Asia/Jakarta

# === Service URLs (used by gateway) ===
GRADE_SERVICE_URL=http://localhost:3001
TRANSCRIPT_SERVICE_URL=http://localhost:3002
GATEWAY_URL=http://localhost:3000

# === Environment ===
NODE_ENV=development
